# ==========================================
# BACKLINKS SEO APPLICATION - ENVIRONMENT CONFIG
# ==========================================
# Leave empty to run in Local Demo / Offline Mode (data persisted in browser localStorage).
# Add your credentials here to activate live Supabase Database, Auth, and Resend emails.

# 1. Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Email Delivery (Gmail SMTP — recommended, no domain needed)
# Create an app password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on your Google account).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# 2b. Resend Email Delivery (fallback, requires a verified domain at resend.com/domains)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 3. Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FREE_TIER_SECURED_LIMIT=5
